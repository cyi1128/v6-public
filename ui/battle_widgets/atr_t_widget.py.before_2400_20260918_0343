            # 重建去重状态：今天每只股票最后一条
            self._prev_signal_state = self._store.last_record_by_code_on_date(today)
            print(f'[ATR做T] 启动加载今日信号 {len(self._signal_logs)} 条，'
                  f'重建去重状态 {len(self._prev_signal_state)} 只', flush=True)
