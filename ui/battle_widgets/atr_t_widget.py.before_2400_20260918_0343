class SignalStore:
    """信号记录 DuckDB 持久化（每次操作短连接，避免多线程锁冲突）"""

    def __init__(self, db_path):
        self.db_path = db_path
        os.makedirs(os.path.dirname(db_path), exist_ok=True)
        self._lock = threading.Lock()
        self._init_db()

    def _connect(self):
        # DuckDB 单文件短连接；read_only=False，自动创建
        return duckdb.connect(self.db_path)

    def _init_db(self):
        con = self._connect()
        try:
            con.execute('''
                CREATE TABLE IF NOT EXISTS signal_records (
                    id INTEGER PRIMARY KEY,
                    trade_date VARCHAR,
                    time_str VARCHAR,
                    code VARCHAR,
                    name VARCHAR,
                    direction VARCHAR,
                    level VARCHAR,
                    trigger_price FLOAT,
                    follow_price FLOAT,
                    pnl_pct FLOAT,
                    status VARCHAR,
                    hold_minutes INTEGER,
                    buy_point FLOAT,
                    sell_point FLOAT,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            ''')
            # 自增 id 序列
            con.execute('CREATE SEQUENCE IF NOT EXISTS signal_records_id_seq START 1')
            con.commit()
        finally:
            con.close()

    def insert(self, rec):
        """插入一条信号记录，返回新 id"""
        with self._lock:
            con = self._connect()
            try:
                cur = con.execute('''
                    INSERT INTO signal_records
                        (id, trade_date, time_str, code, name, direction, level,
                         trigger_price, follow_price, pnl_pct, status, hold_minutes,
                         buy_point, sell_point)
                    VALUES (nextval('signal_records_id_seq'), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    RETURNING id
                ''', (
                    rec['trade_date'], rec['time_str'], rec['code'], rec['name'],
                    rec['direction'], rec['level'], rec['trigger_price'],
                    rec['follow_price'], rec['pnl_pct'], rec['status'],
                    rec['hold_minutes'], rec['buy_point'], rec['sell_point'],
                ))
                new_id = cur.fetchone()[0]
                con.commit()
                return int(new_id)
            finally:
                con.close()

    def select_by_date(self, date_str):
        """查询指定日期的全部记录，按 id 升序"""
        with self._lock:
            con = self._connect()
            try:
                rows = con.execute('''
                    SELECT id, trade_date, time_str, code, name, direction, level,
                           trigger_price, follow_price, pnl_pct, status, hold_minutes,
                           buy_point, sell_point, created_at
                    FROM signal_records
                    WHERE trade_date = ?
                    ORDER BY id ASC
                ''', (date_str,)).fetchall()
                cols = ['id', 'trade_date', 'time_str', 'code', 'name', 'direction',
                        'level', 'trigger_price', 'follow_price', 'pnl_pct', 'status',
                        'hold_minutes', 'buy_point', 'sell_point', 'created_at']
                return [dict(zip(cols, r)) for r in rows]
            finally:
                con.close()

    def update_status(self, rec_id, follow_price, pnl_pct, status, hold_minutes):
        """更新信号状态/后续价/盈亏/持有分钟数"""
        with self._lock:
            con = self._connect()
            try:
                con.execute('''
                    UPDATE signal_records
                    SET follow_price = ?, pnl_pct = ?, status = ?, hold_minutes = ?
                    WHERE id = ?
                ''', (follow_price, pnl_pct, status, hold_minutes, rec_id))
                con.commit()
            finally:
                con.close()

    def last_record_by_code_on_date(self, date_str):
        """取指定日期每只股票最后一条记录，用于重建去重状态
        返回 dict: {code: (level_key, dir_key)}
        """
        with self._lock:
            con = self._connect()
            try:
                rows = con.execute('''
                    SELECT code, level, direction
                    FROM signal_records
                    WHERE trade_date = ?
                    QUALIFY ROW_NUMBER() OVER (PARTITION BY code ORDER BY id DESC) = 1
                ''', (date_str,)).fetchall()
                result = {}
                for code, level_label, dir_label in rows:
                    lvl = LABEL_TO_LEVEL.get(level_label)
                    d = LABEL_TO_DIR.get(dir_label)
                    if lvl and d:
                        result[code] = (lvl, d)
                return result
            except Exception as e:
                # DuckDB 老版本可能不支持 QUALIFY，兜底用 Python 取最后一条
                try:
                    rows = con.execute('''
                        SELECT code, level, direction, id
                        FROM signal_records
                        WHERE trade_date = ?
                        ORDER BY id ASC
                    ''', (date_str,)).fetchall()
                    result = {}
                    for code, level_label, dir_label, _id in rows:
                        lvl = LABEL_TO_LEVEL.get(level_label)
                        d = LABEL_TO_DIR.get(dir_label)
                        if lvl and d:
                            result[code] = (lvl, d)
                    return result
                except Exception as e2:
                    print(f'[ATR做T] 重建去重状态失败: {e2}', flush=True)
                    return {}
            finally:
                con.close()


