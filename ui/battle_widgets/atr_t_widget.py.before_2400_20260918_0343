    def _today_str(self):
        return date.today().strftime('%Y-%m-%d')

    def _load_today_signals(self):
        """程序启动：从数据库加载今天的记录到内存，并重建去重状态"""
        today = self._today_str()
        try:
            rows = self._store.select_by_date(today)
            # 把数据库行转成内存 dict（trigger_dt 从 created_at 恢复）
            self._signal_logs = []
            for r in rows:
                created = r.get('created_at')
                if isinstance(created, datetime):
                    trigger_dt = created
                elif isinstance(created, str):
                    try:
                        trigger_dt = datetime.fromisoformat(created)
                    except Exception:
                        trigger_dt = datetime.now()
                else:
                    trigger_dt = datetime.now()
                self._signal_logs.append({
                    'id': r['id'],
                    'trade_date': r['trade_date'],
                    'time_str': r['time_str'],
                    'code': r['code'],
                    'name': r['name'],
                    'direction': r['direction'],
                    'level': r['level'],
                    'trigger_price': r['trigger_price'],
                    'buy_point': r.get('buy_point') or 0.0,
                    'sell_point': r.get('sell_point') or 0.0,
                    'follow_price': r['follow_price'],
                    'pnl_pct': r['pnl_pct'],
                    'status': r['status'],
                    'hold_minutes': r['hold_minutes'],
                    'trigger_dt': trigger_dt,
