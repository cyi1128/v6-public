        for i, r in enumerate(rows):
            set_table_item(self.table, i, COL_NAME, r['name'],
                           BC.TEXT, bold=True,
                           align=Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft)
            set_table_item(self.table, i, COL_PRICE, f"{r['price']:.2f}",
                           pct_color(r['pct']),
                           align=Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignRight)
            set_table_item(self.table, i, COL_BUY, f"{r['buy_point']:.2f}",
                           SIGNAL_FG['green'], bold=True,
                           align=Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignRight)
            set_table_item(self.table, i, COL_SELL, f"{r['sell_point']:.2f}",
                           SIGNAL_FG['red'], bold=True,
                           align=Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignRight)
            set_table_item(self.table, i, COL_MOMENTUM, r['momentum'],
                           BC.TEXT,
                           align=Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft)
            set_table_item(self.table, i, COL_RISK, r['risk_status'],
                           r['risk_color'], bold=True,
                           align=Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft)
            sig_item = QTableWidgetItem(r['signal_text'])
            lvl = r['signal_level']
            bg = SIGNAL_BG.get(lvl, SIGNAL_BG['gray'])
            fg = SIGNAL_FG.get(lvl, SIGNAL_BG['gray'])
            sig_item.setBackground(QBrush(QColor(bg)))
            sig_item.setForeground(QColor(fg))
            f = sig_item.font()
            f.setBold(True)
            sig_item.setFont(f)
            sig_item.setTextAlignment(Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignCenter)
            self.table.setItem(i, COL_SIGNAL, sig_item)
            set_table_item(self.table, i, COL_ACTION, r['action'],
                           BC.BLUE,
                           align=Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft)
        self.set_update_time()
        self._render_signal_log()
        self._update_signal_stats()

    def _on_failed(self, err):
        self.set_status('数据获取失败')
        self.table.setRowCount(1)
        set_table_item(self.table, 0, 0, f'计算失败: {err}', BC.TEXT3,
                       align=Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignCenter)
        self.table.setSpan(0, 0, 1, 8)

    # ================================================================
    # 信号记录与成功率统计
    # ================================================================
    def _render_signal_log(self):
        """渲染当前视图日期的信号记录表格（最新在最上面）"""
        logs = list(reversed(self._signal_logs))
        self.sig_table.setRowCount(len(logs))
        center = Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignCenter
        right = Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignRight
        for row, log in enumerate(logs):
            # 0 时间
            set_table_item(self.sig_table, row, 0, log['time_str'], BC.TEXT2, align=center)
            # 1 股票
            set_table_item(self.sig_table, row, 1, f"{log['name']}({log['code']})",
                           BC.TEXT_PRIMARY, bold=True, align=center)
            # 2 方向
            dir_color = SIGNAL_FG['green'] if log['direction'] == '买入' else SIGNAL_FG['red']
            set_table_item(self.sig_table, row, 2, log['direction'], dir_color, bold=True, align=center)
            # 3 级别
            lv = log['level']
            if '🟢' in lv:
                lv_color = SIGNAL_FG['green']
            elif '🟡' in lv:
                lv_color = SIGNAL_FG['yellow']
            else:
                lv_color = SIGNAL_FG['red']
            set_table_item(self.sig_table, row, 3, lv, lv_color, bold=True, align=center)
            # 4 触发价
            set_table_item(self.sig_table, row, 4, f"{log['trigger_price']:.2f}",
                           BC.TEXT, align=right)
            # 5 后续价
            fp = log.get('follow_price')
            set_table_item(self.sig_table, row, 5, f"{fp:.2f}" if fp else '--',
                           BC.TEXT2, align=right)
            # 6 盈亏%
            pp = log.get('pnl_pct')
            if pp is not None:
                pnl_color = BC.RED if pp > 0 else (BC.GREEN if pp < 0 else BC.FLAT)
                set_table_item(self.sig_table, row, 6, f"{pp:+.2f}%", pnl_color, bold=True, align=right)
            else:
                set_table_item(self.sig_table, row, 6, '--', BC.TEXT3, align=right)
            # 7 状态
            st = log['status']
            if st == '成功止盈':
                st_color = BC.RED
            elif st == '失败止损':
                st_color = BC.GREEN
            elif st == '日内震荡':
                st_color = BC.TEXT2
            else:
                st_color = BC.ORANGE
            set_table_item(self.sig_table, row, 7, st, st_color, bold=True, align=center)
            # 8 持有时间
            hm = log.get('hold_minutes')
            set_table_item(self.sig_table, row, 8,
                           format_hold_minutes(hm), BC.TEXT2, align=center)

    def _update_signal_stats(self):
        """更新顶部统计摘要（按级别分类）"""
        logs = self._signal_logs
        total = len(logs)
        green_cnt = sum(1 for l in logs if '🟢' in l['level'])
        yellow_cnt = sum(1 for l in logs if '🟡' in l['level'])
        red_cnt = sum(1 for l in logs if '🔴' in l['level'])
        win_cnt = sum(1 for l in logs if l['status'] == '成功止盈')
        lose_cnt = sum(1 for l in logs if l['status'] == '失败止损')
        flat_cnt = sum(1 for l in logs if l['status'] == '日内震荡')
        decided = win_cnt + lose_cnt
        rate = f"{win_cnt / decided * 100:.0f}%" if decided > 0 else '--'
        decided_pnls = [l['pnl_pct'] for l in logs if l['pnl_pct'] is not None]
        avg_pnl = f"{sum(decided_pnls) / len(decided_pnls):+.2f}%" if decided_pnls else '--'

        self._stat_total.setText(f'信号总数: {total}')
        self._stat_green.setText(f'🟢观察: {green_cnt}')
        self._stat_yellow.setText(f'🟡准备: {yellow_cnt}')
        self._stat_red.setText(f'🔴执行: {red_cnt}')
        self._stat_win.setText(f'成功止盈: {win_cnt}')
        self._stat_lose.setText(f'失败止损: {lose_cnt}')
        self._stat_flat.setText(f'日内震荡: {flat_cnt}')
        self._stat_rate.setText(f'成功率: {rate}')
        self._stat_avgpnl.setText(f'平均盈亏: {avg_pnl}')

    # ================================================================
    # 盈亏跟踪：止盈止损 + 15:00收盘判定
    # ================================================================
    def _check_signal_tracking(self):
        """每30秒检查待验证信号的后续价格
        - 买入：毛盈利>1% → 成功止盈；毛亏损>1% → 失败止损
        - 卖出：反向
        - 15:00仍未触发 → 日内震荡
        - 盈亏扣除摩擦成本0.3%
        """
        # 只跟踪"今天"且"待验证"的信号（历史日期不跟踪）
        today_str = self._today_str()
        pending = [l for l in self._signal_logs
                   if l['status'] == '待验证' and l.get('trade_date') == today_str]
        if not pending:
            return

        codes = list(set(l['code'] for l in pending))
        self.run_async(
            self._fetch_pending_quotes,
            self._on_tracking_updated,
            None,
            codes,
        )

    @staticmethod
    def _fetch_pending_quotes(codes):
        """后台线程：获取待验证信号的实时行情"""
        from utils.http_market_data import get_realtime_quotes_http
        return get_realtime_quotes_http(codes) or {}

    def _on_tracking_updated(self, quotes):
        """主线程：根据实时行情更新待验证信号状态，并写库"""
        now = datetime.now()
        # 今天15:00（收盘时间）
        today_close = now.replace(hour=15, minute=0, second=0, microsecond=0)
        after_close = now >= today_close
        updated = False

        for log in self._signal_logs:
            if log['status'] != '待验证':
                continue
            # 只跟踪今天的信号
            if log.get('trade_date') != self._today_str():
                continue

            trigger = log['trigger_price']
            if trigger <= 0:
                continue

            q = quotes.get(log['code'], {}) or {}
            cur_price = float(q.get('price', 0) or 0)

            # 计算持有分钟数
            trigger_dt = log.get('trigger_dt') or now
            hold_min = int((now - trigger_dt).total_seconds() / 60.0)
            if hold_min < 0:
                hold_min = 0

            # ---- 15:00收盘判定：未触发 → 日内震荡 ----
            if after_close:
                log['status'] = '日内震荡'
                log['hold_minutes'] = hold_min
                if cur_price > 0:
                    log['follow_price'] = round(cur_price, 2)
                    # 收盘时也算一个毛盈亏，扣摩擦成本
                    if log['direction'] == '买入':
                        gross = (cur_price - trigger) / trigger * 100.0
                    else:
                        gross = (trigger - cur_price) / trigger * 100.0
                    log['pnl_pct'] = round(gross - FRICTION_COST_PCT, 2)
                else:
                    log['pnl_pct'] = log.get('pnl_pct')
                self._update_signal_db(log)
                updated = True
                continue

            # ---- 盘中：实时行情判止盈止损 ----
            if cur_price <= 0:
                continue
            log['follow_price'] = round(cur_price, 2)

            if log['direction'] == '买入':
                gross = (cur_price - trigger) / trigger * 100.0
                if gross >= TAKE_PROFIT_PCT:
                    log['status'] = '成功止盈'
                elif gross <= -STOP_LOSS_PCT:
                    log['status'] = '失败止损'
            else:  # 卖出
                gross = (trigger - cur_price) / trigger * 100.0
                if gross >= TAKE_PROFIT_PCT:
                    log['status'] = '成功止盈'
                elif gross <= -STOP_LOSS_PCT:
                    log['status'] = '失败止损'

            # 记录净盈亏（扣摩擦成本）
            log['pnl_pct'] = round(gross - FRICTION_COST_PCT, 2)

            if log['status'] != '待验证':
                # 状态确立，记录持有分钟数
                log['hold_minutes'] = hold_min
                self._update_signal_db(log)
                updated = True

        if updated:
            self._render_signal_log()
            self._update_signal_stats()
