    BG = '#f0f4f9'              # 主页面背景（浅灰蓝）
    BG_CARD = '#ffffff'         # 模块卡片背景（白色）
    BG_CARD_HOVER = '#f5f7fa'   # 卡片悬停/交替行
    BG_HEADER = '#f5f7fa'       # 表头背景（浅灰）
    BG_INPUT = '#ffffff'        # 输入框背景
    # 边框
    BORDER = '#e0e0e0'          # 常规边框
    BORDER_L = '#cccccc'        # 稍亮边框（悬停/虚线）
    # 文字
    TEXT = '#333333'            # 正文（深灰）
    TEXT_PRIMARY = '#1a1a1a'    # 标题（深黑灰）
    TEXT2 = '#888888'           # 次要信息（中灰）
    TEXT3 = '#999999'           # 占位/更次要
    # 涨跌
    RED = '#e53935'             # 上涨红
    GREEN = '#43a047'           # 下跌绿
