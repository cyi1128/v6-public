    CYAN = '#00838f'            # 领涨股青色（深色，白底可见）
    PURPLE = '#7b1fa2'
    # 选中
    SELECTED_BG = '#e6f0ff'     # 选中行浅蓝色


def L(text, color=BC.TEXT, size=12, bold=False, align=None):
    """创建标签"""
    label = QLabel(text)
    label.setStyleSheet(
        f'color:{color};font-size:{size}px;'
        f'font-weight:{"bold" if bold else "normal"};background:transparent;'
    )
    if align:
        label.setAlignment(align)
    return label


def make_card():
    """创建浅色金融主题卡片（白色背景，圆角8px，浅灰边框）"""
    card = QFrame()
    card.setStyleSheet(
        f'QFrame{{background:{BC.BG_CARD};border:1px solid {BC.BORDER};'
        f'border-radius:8px;}}'
    )
    return card


def make_table(col_count, headers, min_row_height=26, table_key=None):
    """创建统一样式的浅色金融主题表格
    - 表头：#f5f7fa 背景，深灰文字
    - 行交替：#ffffff / #fafbfc 微妙差异
    - 选中行：浅蓝色 #e6f0ff
    - 滚动条：浅色主题
    - table_key: 传入唯一 key（如 "watchlist"/"opportunity"）则自动通过 QSettings
      记忆列宽与列顺序，程序重启后恢复用户上次拖动的列宽。
      QSettings: organization="QuantMonitorV6", application="TableLayouts"
    """
    table = QTableWidget()
    table.setColumnCount(col_count)
    table.setHorizontalHeaderLabels(headers)
    table.verticalHeader().setVisible(False)
    table.setEditTriggers(QAbstractItemView.EditTrigger.NoEditTriggers)
    table.setSelectionBehavior(QAbstractItemView.SelectionBehavior.SelectRows)
    table.setSelectionMode(QAbstractItemView.SelectionMode.SingleSelection)
    table.setAlternatingRowColors(True)
    table.verticalHeader().setDefaultSectionSize(min_row_height)
    table.setShowGrid(False)
    table.setStyleSheet(f"""
        QTableWidget{{
            background:{BC.BG_CARD};color:{BC.TEXT};
            gridline-color:#e8e8e8;border:none;
            font-size:12px;alternate-background-color:#fafbfc;
        }}
        QTableWidget::item{{padding:4px 8px;border-bottom:1px solid #e8e8e8;}}
        QTableWidget::item:selected{{background:{BC.SELECTED_BG};color:{BC.TEXT_PRIMARY};}}
        QHeaderView::section{{
            background:{BC.BG_HEADER};color:{BC.TEXT};
            border:none;border-bottom:1px solid {BC.BORDER};
            padding:6px 8px;font-size:11px;font-weight:bold;
        }}
        QHeaderView::section:hover{{
            background:#e8eef5;
        }}
        /* 排序箭头：确保浅色主题下升序/降序箭头可见 */
        QHeaderView::down-arrow{{
            image:none;width:8px;height:8px;
            border-left:4px solid transparent;
            border-right:4px solid transparent;
            border-top:5px solid {BC.RED};
            margin-left:2px;
        }}
        QHeaderView::up-arrow{{
            image:none;width:8px;height:8px;
            border-left:4px solid transparent;
            border-right:4px solid transparent;
            border-bottom:5px solid {BC.GREEN};
            margin-left:2px;
        }}
        QScrollBar:vertical{{background:#f0f0f0;width:8px;}}
        QScrollBar::handle:vertical{{background:#c0c0c0;border-radius:4px;}}
        QScrollBar::handle:vertical:hover{{background:#a0a0a0;}}
        QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical{{height:0;}}
        QScrollBar:horizontal{{background:#f0f0f0;height:8px;}}
        QScrollBar::handle:horizontal{{background:#c0c0c0;border-radius:4px;}}
        QScrollBar::handle:horizontal:hover{{background:#a0a0a0;}}
        QScrollBar::add-line:horizontal,QScrollBar::sub-line:horizontal{{width:0;}}
    """)
    header = table.horizontalHeader()
    header.setSectionResizeMode(QHeaderView.ResizeMode.Interactive)
    header.setStretchLastSection(True)

    # ---- 列宽/列顺序 QSettings 记忆 ----
    if table_key:
        settings = QSettings("QuantMonitorV6", "TableLayouts")
        state_key = table_key + "/header_state"
        saved_state = settings.value(state_key)
        # 列宽变化时自动保存（每次拖动都写，Qt 关闭时也会 sync）
        header.sectionResized.connect(
            lambda *_: settings.setValue(state_key, header.saveState()))
        # 【崩溃修复】restoreState 在 Qt C++ 层执行，若 saved_state 列数与当前表格
        # 列数不匹配（近期加了新列/删了列），会直接 0xC0000005 段错误，Python try/except
        # 无法捕获。这里直接不恢复旧 state，让列宽走默认值；新 state 会在用户拖动列宽时
        # 由 sectionResized 信号重新保存。首次启动后即恢复正常记忆功能。
        if saved_state:
            # 清除可能损坏的旧 state（列数不匹配的），避免下次启动再崩溃
            settings.remove(state_key)
            print(f"[表格] 已清除旧列宽布局 {table_key}（避免列数不匹配段错误）", flush=True)
    return table


def set_table_item(table, row, col, text, color=None, bold=False, align=None):
    """设置表格单元格"""
    item = QTableWidgetItem(text)
    if color:
        item.setForeground(QColor(color))
    if bold:
        f = item.font()
        f.setBold(True)
        item.setFont(f)
    if align:
        item.setTextAlignment(align)
    else:
        item.setTextAlignment(Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft)
    table.setItem(row, col, item)
    return item


def pct_color(pct):
    """根据涨跌幅返回颜色：上涨红、下跌绿、平盘灰"""
    if pct is None:
        return BC.TEXT2
    try:
        v = float(pct)
        if v > 0:
            return BC.RED
        elif v < 0:
            return BC.GREEN
        else:
            return BC.FLAT
    except (ValueError, TypeError):
        pass
    return BC.FLAT


def format_pct(pct):
    """格式化涨跌幅"""
    if pct is None:
        return '--'
    try:
        v = float(pct)
        sign = '+' if v > 0 else ''
        return f'{sign}{v:.2f}%'
    except (ValueError, TypeError):
        return '--'


