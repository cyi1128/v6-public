/* ============================================================
   量化交易系统全局UI样式
   参考专业量化交易终端深色卡片风格
   ============================================================ */

/* ===== 全局 ===== */
QWidget {
    background-color: #0D1117;
    color: #FFFFFF;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}

QMainWindow {
    background-color: #080C12;
}

/* ===== 菜单栏 ===== */
QMenuBar {
    background-color: #0D1117;
    color: #FFFFFF;
    border-bottom: 1px solid #30363D;
    padding: 2px 0px;
    font-size: 12px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 14px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #21262D;
    color: #F85149;
}

QMenu {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #21262D;
    color: #F85149;
}

/* ===== TabWidget ===== */
QTabWidget::pane {
    border: 1px solid #30363D;
    border-radius: 0px;
    background-color: #0D1117;
    top: -1px;
}

QTabBar::tab {
    background-color: #0D1117;
    color: #8B949E;
    padding: 10px 18px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 0px;
    font-size: 12px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #161B22;
    color: #F85149;
    border-bottom: 2px solid #F85149;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #161B22;
    color: #FFFFFF;
}

/* ===== 表格 ===== */
QTableWidget {
    background-color: #0D1117;
    alternate-background-color: #161B22;
    gridline-color: #21262D;
    border: 1px solid #30363D;
    border-radius: 6px;
    selection-background-color: #21262D;
    selection-color: #FFFFFF;
    outline: none;
}

QTableWidget::item {
    padding: 6px 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #21262D;
    color: #FFFFFF;
}

QTableWidget::item:hover {
    background-color: #1C2128;
}

QHeaderView::section {
    background-color: #161B22;
    color: #8B949E;
    padding: 8px 8px;
    border: none;
    border-right: 1px solid #21262D;
    border-bottom: 1px solid #30363D;
    font-weight: 600;
    font-size: 11px;
}

QHeaderView::section:hover {
    background-color: #21262D;
    color: #F85149;
}

/* ===== 按钮 ===== */
QPushButton {
    background-color: #161B22;
    color: #FFFFFF;
    border: 1px solid #30363D;
    border-radius: 5px;
    padding: 6px 14px;
    font-weight: 500;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #21262D;
    border-color: #F85149;
    color: #F85149;
}

QPushButton:pressed {
    background-color: #161B22;
}

QPushButton:disabled {
    color: #484F58;
    border-color: #21262D;
}

/* 主要按钮 - 红色渐变 */
QPushButton[class="primary"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #F85149, stop:1 #DA3633);
    color: #FFFFFF;
    border: 1px solid #F85149;
    font-weight: 600;
}

QPushButton[class="primary"]:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #FF6B5E, stop:1 #F85149);
    color: #FFFFFF;
    border: 1px solid #FF8A7E;
}

/* 成功按钮 - 绿色 */
QPushButton[class="success"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #3FB950, stop:1 #2D9A3E);
    color: #FFFFFF;
    border: 1px solid #3FB950;
}

QPushButton[class="success"]:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #5FD06F, stop:1 #3FB950);
}

/* 危险按钮 - 橙色 */
QPushButton[class="danger"] {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #FF8C00, stop:1 #E07800);
    color: #FFFFFF;
    border: 1px solid #FF8C00;
}

QPushButton[class="danger"]:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #FFA533, stop:1 #FF8C00);
}

/* 辅助按钮 - 深灰 */
QPushButton[class="secondary"] {
    background-color: #161B22;
    color: #8B949E;
    border: 1px solid #30363D;
}

QPushButton[class="secondary"]:hover {
    background-color: #21262D;
    color: #FFFFFF;
    border-color: #484F58;
}

/* ===== 输入框 ===== */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #0D1117;
    color: #FFFFFF;
    border: 1px solid #30363D;
    border-radius: 5px;
    padding: 5px 8px;
    selection-background-color: #F85149;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #F85149;
}

/* ===== 下拉框 ===== */
QComboBox {
    background-color: #0D1117;
    color: #FFFFFF;
    border: 1px solid #30363D;
    border-radius: 5px;
    padding: 5px 8px;
}

QComboBox:hover {
    border-color: #F85149;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #161B22;
    border: 1px solid #30363D;
    selection-background-color: #21262D;
    color: #FFFFFF;
}

/* ===== 滚动条 ===== */
QScrollBar:vertical {
    background-color: #0D1117;
    width: 6px;
    border-radius: 3px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #30363D;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #F85149;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #0D1117;
    height: 6px;
    border-radius: 3px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #30363D;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #F85149;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ===== GroupBox ===== */
QGroupBox {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: 600;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0px 8px;
    color: #F85149;
}

/* ===== 标签 ===== */
QLabel {
    background: transparent;
    color: #FFFFFF;
}

QLabel[class="title"] {
    font-size: 16px;
    font-weight: 700;
    color: #FFFFFF;
}

QLabel[class="subtitle"] {
    font-size: 12px;
    color: #8B949E;
}

QLabel[class="up"] {
    color: #F85149;
    font-weight: 700;
}

QLabel[class="down"] {
    color: #3FB950;
    font-weight: 700;
}

QLabel[class="ai_score"] {
    color: #F85149;
    font-size: 20px;
    font-weight: 700;
    font-family: "Consolas", "Courier New", monospace;
}

QLabel[class="mono"] {
    font-family: "Consolas", "Courier New", monospace;
}

QLabel[class="limit_up"] {
    color: #FFD700;
    font-weight: 700;
}

QLabel[class="limit_down"] {
    color: #58A6FF;
    font-weight: 700;
}

/* ===== 状态栏 ===== */
QStatusBar {
    background-color: #080C12;
    color: #8B949E;
    border-top: 1px solid #30363D;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

/* ===== 分割线 ===== */
QSplitter::handle {
    background-color: #30363D;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

/* ===== 复选框/单选框 ===== */
QCheckBox, QRadioButton {
    color: #FFFFFF;
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #30363D;
    border-radius: 3px;
    background-color: #0D1117;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #F85149;
    border-color: #F85149;
}

/* ===== 进度条 ===== */
QProgressBar {
    background-color: #0D1117;
    border: 1px solid #30363D;
    border-radius: 4px;
    text-align: center;
    color: #FFFFFF;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #F85149, stop:1 #FF6B5E);
    border-radius: 3px;
}

/* ===== ToolTip ===== */
QToolTip {
    background-color: #161B22;
    color: #FFFFFF;
    border: 1px solid #F85149;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ===== SpinBox ===== */
QSpinBox, QDoubleSpinBox {
    background-color: #0D1117;
    color: #FFFFFF;
    border: 1px solid #30363D;
    border-radius: 5px;
    padding: 3px 6px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #F85149;
}

/* ===== ListWidget ===== */
QListWidget {
    background-color: #0D1117;
    border: 1px solid #30363D;
    border-radius: 6px;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #21262D;
}

QListWidget::item:selected {
    background-color: #21262D;
    color: #FFFFFF;
}

QListWidget::item:hover {
    background-color: #161B22;
}

/* ===== 侧边栏导航 ===== */
QListWidget[class="sidebar"] {
    background-color: #0D1117;
    border: none;
    border-right: 1px solid #21262D;
    border-radius: 0px;
    outline: none;
}

QListWidget[class="sidebar"]::item {
    padding: 10px 16px;
    border: none;
    border-left: 3px solid transparent;
    color: #8B949E;
    font-size: 13px;
    font-weight: 500;
}

QListWidget[class="sidebar"]::item:selected {
    background-color: #21262D;
    color: #FFFFFF;
    border-left: 3px solid #F85149;
}

QListWidget[class="sidebar"]::item:hover {
    background-color: #161B22;
    color: #FFFFFF;
}
